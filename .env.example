# =========================================================================
# PBAS Admin UI Environment Variables Configuration
# Copy this file to '.env' and adjust values for your environment.
# =========================================================================

# --- 1. Development Proxy Configuration ---
# Used by Vite local dev server (npm run dev) to proxy calls to the backend.
VITE_BACKEND_URL=http://localhost:8000/api/v1

# --- 2. Routing & Build Configuration ---
# The public base path for Vite build assets (must start and end with '/').
# Use '/panel/' if served via FastAPI at /panel, or '/' if hosted as a standalone SPA (Netlify, Vercel, etc.)
VITE_APP_BASE_PATH=/panel/

# The React Router basename.
# Use '/panel' if hosted under a subdirectory, or '/' if hosted at the root of a domain/subdomain.
VITE_ROUTER_BASENAME=/panel

# --- 3. API Endpoint Configuration ---
# The backend API URL prefix for the app to communicate with.
# If hosted on the same origin (e.g. served by FastAPI), you can use '/api/v1'.
# If hosted standalone, specify the absolute URL (e.g., 'https://api.yourdomain.com/api/v1').
VITE_API_BASE_URL=/api/v1

# --- 4. Keycloak / DYPIU SSO (OIDC + PKCE) Configuration ---
# Base URL of DYPIU Keycloak instance (omit or leave empty to disable SSO button)
VITE_KEYCLOAK_URL=https://auth.dypiu.ac.in

# Keycloak realm name
VITE_KEYCLOAK_REALM=dypiu

# Keycloak OIDC Public Client ID for PBAS Admin Portal
VITE_KEYCLOAK_CLIENT_ID=faculty-appraisal-admin

# OIDC scopes
VITE_KEYCLOAK_SCOPES=openid email profile
